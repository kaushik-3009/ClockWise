rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsEntity(userId) {
      return isOwner(userId) && request.resource.data.user_id == userId;
    }

    function ownsExistingEntity(userId) {
      return isOwner(userId) && resource.data.user_id == userId;
    }

    // Users can only read/write their own user document and subcollections.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if ownsEntity(userId);
        allow update: if ownsExistingEntity(userId) && ownsEntity(userId);
        allow delete: if ownsExistingEntity(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if ownsEntity(userId);
        allow update: if ownsExistingEntity(userId) && ownsEntity(userId);
        allow delete: if ownsExistingEntity(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if ownsEntity(userId);
        allow update: if ownsExistingEntity(userId) && ownsEntity(userId);
        allow delete: if ownsExistingEntity(userId);
      }

      match /streaks/{date} {
        allow read: if isOwner(userId);
        allow create: if ownsEntity(userId);
        allow update: if ownsExistingEntity(userId) && ownsEntity(userId);
        allow delete: if ownsExistingEntity(userId);
      }

      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create: if ownsEntity(userId);
        allow update: if ownsExistingEntity(userId) && ownsEntity(userId);
        allow delete: if ownsExistingEntity(userId);
      }

      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      match /backups/{backupId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
